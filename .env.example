# Koordine tanıtım sitesi — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayıp doldurun. Gerçek anahtarları depoya eklemeyin.

# --- Site adresleri ---
# Kanonik site adresi (sondaki / olmadan). Varsayılan: https://koordine.com.tr
NEXT_PUBLIC_SITE_URL=https://koordine.com.tr
# Uygulamanın adresi (giriş/kayıt bağlantıları). Varsayılan: https://app.koordine.com.tr
NEXT_PUBLIC_APP_URL=https://app.koordine.com.tr

# --- İletişim formu (/api/contact) ---
# Resend API anahtarı. Tanımlı değilse form, kullanıcıya hazır bir mailto: bağlantısı gösterir.
RESEND_API_KEY=
# Taleplerin gönderileceği adres. Varsayılan: destek@koordine.com.tr
CONTACT_TO=
# Gönderen adres; alan adı Resend'de doğrulanmış olmalı. Varsayılan: Koordine <bildirim@koordine.com.tr>
CONTACT_FROM=

# --- Arama motoru doğrulama ---
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
